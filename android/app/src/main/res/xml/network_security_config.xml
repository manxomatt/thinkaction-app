<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config: trust system CAs for all HTTPS connections -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust system CA certificates -->
            <certificates src="system" />
            <!-- Also trust user-installed CA certificates (for debugging/enterprise) -->
            <certificates src="user" overridePins="true" />
        </trust-anchors>
    </base-config>
    
    <!-- Development: Allow cleartext (HTTP) for local development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.2.1</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" overridePins="true" />
        </trust-anchors>
    </domain-config>
    
    <!-- Domain-specific config for API and storage services (HTTPS only) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">thinkaction.id</domain>
        <domain includeSubdomains="true">r2.cloudflarestorage.com</domain>
        <domain includeSubdomains="true">r2.dev</domain>
        <domain includeSubdomains="true">cloudflare.com</domain>
        <domain includeSubdomains="true">amazonaws.com</domain>
        <domain includeSubdomains="true">s3.amazonaws.com</domain>
        <domain includeSubdomains="true">s3.ap-southeast-1.amazonaws.com</domain>
        <trust-anchors>
            <!-- Trust system CA certificates -->
            <certificates src="system" />
            <!-- Also trust user-installed CA certificates -->
            <certificates src="user" overridePins="true" />
        </trust-anchors>
    </domain-config>
</network-security-config>
